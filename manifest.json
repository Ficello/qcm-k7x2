{
  "manifest_version": 3,
  "name": "QCM Clavier",
  "version": "1.0.0",
  "description": "Raccourcis clavier personnalisables pour les plateformes de QCM de médecine (EDN.fr, Hypocampus, UNESS, Asclepia).",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qcm-clavier@local.edn",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "QCM Clavier",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.edn.fr/*"],
      "js": [
        "src/core/schema.js",
        "src/core/storage.js",
        "src/core/keybind.js",
        "src/core/dom.js",
        "src/adapters/edn.js",
        "src/content/main.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.hypocampus.fr/*"],
      "js": [
        "src/core/schema.js",
        "src/core/storage.js",
        "src/core/keybind.js",
        "src/core/dom.js",
        "src/adapters/hypocampus.js",
        "src/content/main.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.uness.fr/*"],
      "js": [
        "src/core/schema.js",
        "src/core/storage.js",
        "src/core/keybind.js",
        "src/core/dom.js",
        "src/adapters/uness.js",
        "src/content/main.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["https://*.asclepia.io/*"],
      "js": [
        "src/core/schema.js",
        "src/core/storage.js",
        "src/core/keybind.js",
        "src/core/dom.js",
        "src/adapters/asclepia.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://refoua.fr/*", "https://refoua.vercel.app/*"],
      "js": [
        "src/core/schema.js",
        "src/core/storage.js",
        "src/core/keybind.js",
        "src/core/dom.js",
        "src/adapters/refoua.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
