{
  "manifest_version": 3,
  "name": "Connecteur EDN",
  "author": "Angelo Marcis",
  "version": "1.1.0",
  "description": "Connecteur Anki EDN et raccourcis clavier QCM pour EDN.fr, Hypocampus, UNESS (LiSA & BNE), Asclepia et Refoua.",
  "homepage_url": "https://ficello.github.io/qcm-k7x2/",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.edn.fr/*",
    "*://*.hypocampus.fr/*",
    "*://*.uness.fr/*",
    "https://*.asclepia.io/*"
  ],
  "background": {
    "scripts": ["src/background/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "connecteur-edn@anki-edn.fr",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Connecteur EDN",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.edn.fr/*"],
      "js": [
        "src/core/schema.js",
        "src/core/storage.js",
        "src/core/keybind.js",
        "src/core/dom.js",
        "src/core/anki_connector.js",
        "src/adapters/edn.js",
        "src/content/main.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.hypocampus.fr/*"],
      "js": [
        "src/core/schema.js",
        "src/core/storage.js",
        "src/core/keybind.js",
        "src/core/dom.js",
        "src/core/anki_connector.js",
        "src/adapters/hypocampus.js",
        "src/content/main.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.uness.fr/*"],
      "js": [
        "src/core/schema.js",
        "src/core/storage.js",
        "src/core/keybind.js",
        "src/core/dom.js",
        "src/core/anki_connector.js",
        "src/adapters/uness.js",
        "src/content/main.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["https://*.asclepia.io/*"],
      "js": [
        "src/core/schema.js",
        "src/core/storage.js",
        "src/core/keybind.js",
        "src/core/dom.js",
        "src/core/anki_connector.js",
        "src/adapters/asclepia.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://refoua.fr/*", "https://refoua.vercel.app/*"],
      "js": [
        "src/core/schema.js",
        "src/core/storage.js",
        "src/core/keybind.js",
        "src/core/dom.js",
        "src/adapters/refoua.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ficello.github.io/qcm-k7x2/*", "https://c2su.github.io/Anki_EDN/*"],
      "js": [
        "src/content/install_handshake.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
